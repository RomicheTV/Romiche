{
  "expo": {
    "name": "S.O. Londais",
    "slug": "so-londais",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "fr.solondais.app"
    },
    "android": {
      "package": "fr.solondais.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#2E5FE0"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "566739f5-0581-4761-8a7a-1e300417f73d"
      }
    }
  }
}
